{
  "name": "hscan",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "scan": "tsx scripts/scan.ts",
    "contracts:build": "node scripts/foundry.mjs build",
    "deploy:registry": "tsx scripts/deploy-registry.ts",
    "deploy:verify": "tsx scripts/deploy-e2e.ts",
    "contracts:test": "node scripts/foundry.mjs test",
    "simulation": "tsx scripts/simulate.ts",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "viem": "^2.38.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@chainlink/cre-sdk": "^1.0.0",
    "@foundry-rs/anvil": "^1.4.0",
    "@foundry-rs/forge": "^1.4.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@uniswap/v4-core": "1.0.2",
    "prettier": "^3.9.10",
    "puppeteer-core": "^25.16.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
