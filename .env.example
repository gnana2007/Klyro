# Klyro server environment. Node.js 24 required.
# Everything here is server-only. Never prefix a secret with NEXT_PUBLIC_.
# Copy to .env.local for local runs. Never commit a filled file.

# ── Storage ──────────────────────────────────────────────────────────────────
# SQLite file. Local and container hosts only: it must live on a persistent
# disk. On a serverless host (Vercel) the filesystem is ephemeral and this file
# is lost on every deploy, so use a host with a volume (Render, Fly, a VM).
DATABASE_PATH=./data/klyro.sqlite

# ── Blockchain read access ───────────────────────────────────────────────────
# Public endpoints are fine for reads. Set your own provider URL for production
# throughput. Read-only: no key or private key is ever used by the server.
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_BASE=https://base-rpc.publicnode.com
RPC_LOCAL=http://127.0.0.1:8545

# ── 0G inference ─────────────────────────────────────────────────────────────
ZERO_G_API_KEY=
# Must be an id returned by GET /api/ai/models. No model is silently substituted.
# TeeML models start with 0g (e.g. 0gm-1.0-35b-a3b).
ZERO_G_MODEL=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_TRUST_MODE=private
# Set true only after confirming the account has usable credits. The app never
# funds an account. A zero balance surfaces as HTTP 402 pay_no_balance.
ZERO_G_FREE_CREDITS_CONFIRMED=false
ZERO_G_MAX_OUTPUT_TOKENS=1500

# ── Access control ───────────────────────────────────────────────────────────
# Required when APP_ORIGIN is a public host: a production build served on
# loopback (127.0.0.1 / localhost) is single-operator and does not need it.
# Send it as the x-operator-token header for AI/deploy/registry POSTs.
OPERATOR_TOKEN=
# The host the app is served from. Same-origin requests are accepted on any
# port, so a preview URL on a different port still works.
APP_ORIGIN=http://127.0.0.1:3000
APP_ADDITIONAL_ORIGINS=

# ── Report registry (HookRiskRegistry) ───────────────────────────────────────
# The address you actually deployed, on the chain you actually used. Leave empty
# until a deployment receipt exists. Publication is signed by the user's wallet
# in the browser; the server holds no key.
REGISTRY_ADDRESS=
REGISTRY_CHAIN_ID=11155111
# Optional. Enables in-app "is the source verified?" checks on the explorer.
ETHERSCAN_API_KEY=

# ── Chainlink CRE ────────────────────────────────────────────────────────────
CRE_API_BASE_URL=http://127.0.0.1:3000
CRE_REGISTRY_ADDRESS=
CRE_FORWARDER_ADDRESS=

# ── Scheduled monitoring ─────────────────────────────────────────────────────
# Set false on a serverless host: there is no long-lived process to run a timer.
MONITOR_ENABLED=true
# Minimum minutes between automatic rescans of one hook (5..10080).
MONITOR_DEFAULT_INTERVAL_MINUTES=60

# No private key belongs in this file. Deployment and publication are signed by
# the operator's browser wallet, one approval per transaction.
