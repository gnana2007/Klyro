# Server only. Never prefix secrets with NEXT_PUBLIC_. Node.js 24 required.
DATABASE_PATH=./data/hscan.sqlite
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
RPC_SEPOLIA=https://ethereum-sepolia-rpc.publicnode.com
RPC_BASE=https://base-rpc.publicnode.com
RPC_LOCAL=http://127.0.0.1:8545
# Use a model actually listed by your account; no model is silently substituted.
ZERO_G_API_KEY=
ZERO_G_MODEL=
ZERO_G_BASE_URL=https://router-api.0g.ai/v1
ZERO_G_TRUST_MODE=private
# Set true only after confirming the account has usable free credits. No funding happens in this app.
ZERO_G_FREE_CREDITS_CONFIRMED=false
ZERO_G_MAX_OUTPUT_TOKENS=1500
# Required for protected inference/administrative endpoints when publicly hosted.
OPERATOR_TOKEN=
APP_ORIGIN=http://127.0.0.1:3000
APP_ADDITIONAL_ORIGINS=
# Deployed registry and its chain, not an invented address.
REGISTRY_ADDRESS=
REGISTRY_CHAIN_ID=11155111
CRE_API_BASE_URL=http://127.0.0.1:3000
CRE_REGISTRY_ADDRESS=
CRE_FORWARDER_ADDRESS=
# No wallet private key is required for scanning.
